<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDisplayName</key>
	<string>TicketMan</string>
	<!-- Shop servers are usually on the local network, which iOS asks about the first time the app reaches one -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>TicketMan connects to your shop's server on the local network.</string>
	<!-- Plain http:// is only allowed to local addresses and .local names, the same servers the app's "Not secure"
	     warning covers. Anything on the internet has to be https:// -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
